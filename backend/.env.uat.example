# UAT (User Acceptance Testing) environment — a template for a deployment COMPLETELY SEPARATE
# from production: its own database, its own server process, its own domain/URL if possible.
# Copy to a file named `.env` in the UAT deployment only — never reuse production's .env, and
# never point this DATABASE_URL at the same database production uses.
#
# See docs/UAT.md for the full environment setup and account-creation walkthrough.

NODE_ENV=production
PORT=8765
HOST=0.0.0.0
PUBLIC_ORIGIN=https://YOUR-UAT-BACKEND-DOMAIN
# The frontend origin(s) allowed to call this UAT backend. If the UAT frontend is a separate
# GitHub Pages deployment or branch, list that origin here — not production's.
ALLOWED_ORIGINS=https://YOUR-UAT-FRONTEND-ORIGIN

# A dedicated UAT database. MUST be a different database (ideally a different server/instance)
# than production's DATABASE_URL — this is what actually makes UAT isolated, not a flag.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/UAT_DBNAME

# This MUST be "uat", not "production" — it is what makes the "User Acceptance Testing" banner
# appear on every page, and it scopes every account query to environment='uat' only, so UAT
# accounts (including the stakeholder's) cannot authenticate against a production-environment
# server process even if the credentials were somehow reused.
APP_ENVIRONMENT=uat
