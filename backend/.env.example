# --- Core server settings (both storage modes) ---
NODE_ENV=production
PORT=8765
HOST=0.0.0.0
PUBLIC_ORIGIN=https://YOUR-BACKEND-DOMAIN
ALLOWED_ORIGINS=https://lilth2.github.io

# --- Storage mode A: single-file JSON store (no database) ---
# Used only when DATABASE_URL below is NOT set. One hardcoded admin account; see
# "npm run setup:admin". Leave DATABASE_URL unset to use this mode.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE-WITH-YOUR-INITIAL-STRONG-PASSWORD
DATA_PATH=/app/backend/.private/dataset.json

# --- Storage mode B: PostgreSQL + multi-account auth (recommended; required for the UAT
# stakeholder account, bulk-import provenance, and the feedback tracker) ---
# Setting DATABASE_URL switches the whole server into this mode; ADMIN_USERNAME/ADMIN_PASSWORD/
# DATA_PATH above are then ignored. Run `npm run db:migrate` once against this database, then
# `npm run setup:accounts -- --admin-username admin --stakeholder-username <hers>` to create
# accounts (see docs/UAT.md). Never commit a real connection string.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# APP_ENVIRONMENT=production
